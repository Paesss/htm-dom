{
  "name": "htm-dom",
  "version": "0.1.12",
  "description": "A tiny, framework-free DOM helper for JavaScript and TypeScript. It gives you HTML-like tagged templates without building one large HTML string and handing it to innerHTML",
  "keywords": [
    "dom",
    "htm",
    "html",
    "tagged-templates",
    "typescript"
  ],
  "homepage": "https://github.com/Paesss/htm-dom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paesss/htm-dom.git"
  },
  "author": {
    "name": "Paesss",
    "url": "https://github.com/Paesss"
  },
  "bugs": {
    "url": "https://github.com/Paesss/htm-dom/issues"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/htm-dom.cjs",
  "module": "./dist/htm-dom.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/htm-dom.umd.js",
  "jsdelivr": "./dist/htm-dom.umd.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/htm-dom.js",
      "require": "./dist/htm-dom.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "lint-staged": {
    "*.{js,ts}": [
      "biome format --write --no-errors-on-unmatched",
      "vitest related --run"
    ],
    "README.{hbs,md,html}": [
      "npm run build:docs --",
      "git add README.md README.html"
    ]
  },
  "scripts": {
    "dev": "vite",
    "test": "vitest run --environment jsdom",
    "format": "biome format --write --no-errors-on-unmatched",
    "preview": "vite preview",
    "deps:check": "npx npm-check-updates",
    "deps:update": "npx npm-check-updates -u && npm install",
    "clean": "rimraf dist",
    "clean:types": "rimraf dist/types",
    "build": "npm run clean && npm run build:lib && npm run build:userscript",
    "build:lib": "npm run build:types && npm run build:internal",
    "build:internal": "vite build",
    "build:userscript": "vite build --config vite.userscript.config.ts",
    "build:types": "npm run clean:types && tsc -p tsconfig.types.json",
    "build:docs": "npm run build:docs:internal && biome format --write --no-errors-on-unmatched README.html",
    "build:docs:internal": "tsx docs/render-docs.ts",
    "build:config": "tsc -p tsconfig.node.json --noEmit",
    "prebuild": "npm run build:config && npm run build:docs:internal && npm run format",
    "preversion": "npm run test",
    "version": "npm run build && git add .",
    "prepublishOnly": "npm run test && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.4.0",
    "handlebars": "^4.7.9",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.3.0",
    "marked": "^18.0.11",
    "marked-shiki": "^1.2.1",
    "rimraf": "^6.1.3",
    "shiki": "^4.4.3",
    "tslib": "^2.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-monkey": "^8.1.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "xhtm": "1.8.0"
  }
}
