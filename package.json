{
  "name": "htm-dom",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:config && npm run test",
    "build:internal": "vite build",
    "build": "npm run prebuild && npm run build:internal",
    "build:userscript": "npm run prebuild && npm run build:userscript:internal",
    "build:userscript:internal": "vite build --config vite.userscript.config.ts",
    "build:config": "tsc -p tsconfig.node.json --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "build:package": "npm run prebuild && npm run build:types && npm run build:internal && npm run build:userscript:internal",
    "build:docs": "tsx scripts/render-docs.ts",
    "test": "vitest run --environment jsdom",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/htm-dom.js",
      "require": "./dist/htm-dom.cjs",
      "default": "./dist/htm-dom.umd.js"
    }
  },
  "main": "./dist/htm-dom.cjs",
  "module": "./dist/htm-dom.js",
  "unpkg": "./dist/htm-dom.umd.js",
  "jsdelivr": "./dist/htm-dom.umd.js",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@biomejs/js-api": "^6.0.0",
    "@types/node": "^26.2.0",
    "handlebars": "^4.7.9",
    "jsdom": "^30.0.1",
    "marked": "^18.0.10",
    "marked-shiki": "^1.2.1",
    "shiki": "^4.4.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "xhtm": "1.8.0"
  }
}
