{
  "name": "htm-dom",
  "version": "0.1.1",
  "description": "A tiny, framework-free DOM helper for JavaScript and TypeScript. It gives you HTML-like tagged templates without building one large HTML string and handing it to innerHTML",
  "homepage": "https://github.com/Paesss/htm-dom",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Paesss/htm-dom.git"
  },
  "author": {
    "name": "Paesss",
    "url": "https://github.com/Paesss"
  },
  "bugs": {
    "url": "https://github.com/Paesss/htm-dom/issues"
  },
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "npm run build:config && npm run build:docs:internal && npm run format && npm run test",
    "build:internal": "vite build",
    "build": "npm run prebuild && npm run build:internal",
    "build:userscript": "npm run prebuild && npm run build:userscript:internal",
    "build:userscript:internal": "vite build --config vite.userscript.config.ts",
    "build:config": "tsc -p tsconfig.node.json --noEmit",
    "build:types": "tsc -p tsconfig.types.json",
    "build:package": "npm run prebuild && npm run build:types && npm run build:internal && npm run build:userscript:internal",
    "build:docs:internal": "tsx docs/render-docs.ts",
    "build:docs": "npm run build:docs:internal && npm run format",
    "test": "vitest run --environment jsdom",
    "format": "npx @biomejs/biome format --write",
    "preview": "vite preview"
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/htm-dom.js",
      "require": "./dist/htm-dom.cjs"
    }
  },
  "main": "./dist/htm-dom.cjs",
  "module": "./dist/htm-dom.js",
  "unpkg": "./dist/htm-dom.umd.js",
  "jsdelivr": "./dist/htm-dom.umd.js",
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@biomejs/js-api": "^6.0.0",
    "@types/node": "^26.2.0",
    "handlebars": "^4.7.9",
    "jsdom": "^30.0.1",
    "marked": "^18.0.10",
    "marked-shiki": "^1.2.1",
    "shiki": "^4.4.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.0.11",
    "vite-plugin-monkey": "^8.0.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "xhtm": "1.8.0"
  }
}
